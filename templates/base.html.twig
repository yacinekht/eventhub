<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}EventHub Enigma{% endblock %}</title>

    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 64 64%22><rect width=%2264%22 height=%2264%22 rx=%2216%22 fill=%22%236A4DFF%22/><circle cx=%2232%22 cy=%2232%22 r=%2214%22 fill=%22none%22 stroke=%22%23fff%22 stroke-width=%228%22/></svg>">

    <!-- Bootstrap 5.3 & FontAwesome 6 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --ink: #0F172A;
            --ink-soft: #64748B;
            --bg: #F8FAFC;
            --card: #FFFFFF;
            --accent: #6366F1;
            --accent-hover: #4F46E5;
            --accent-light: #EEF2FF;
            --line: #E2E8F0;
            --radius-lg: 24px;
            --radius-md: 16px;
            --grad: linear-gradient(135deg, #6366F1 0%, #8B5CF6 50%, #EC4899 100%);
            --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            --shadow-lg: 0 20px 25px -5px rgba(99, 102, 241, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.04);
        }

        body {
            background-color: var(--bg);
            background-image:
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.08) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(236, 72, 153, 0.06) 0px, transparent 50%);
            background-attachment: fixed;
            color: var(--ink);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 1.025rem;
            line-height: 1.6;
        }

        h1, h2, h3, h4, .brand {
            font-family: 'Bricolage Grotesque', sans-serif;
            letter-spacing: -0.025em;
        }

        /* Navbar */
        .eh-nav {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--line);
            padding: 0.85rem 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }

        .brand {
            font-weight: 800;
            font-size: 1.35rem;
            color: var(--ink);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
        }

        .brand-mark {
            width: 40px;
            height: 40px;
            border-radius: 12px;
            background: var(--grad);
            display: grid;
            place-items: center;
            color: #fff;
            box-shadow: 0 8px 16px -4px rgba(99, 102, 241, 0.4);
        }

        .nav-link-eh {
            color: var(--ink-soft);
            font-weight: 600;
            text-decoration: none;
            padding: 0.55rem 1.1rem;
            border-radius: 99px;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            font-size: 0.95rem;
        }

        .nav-link-eh:hover {
            color: var(--accent);
            background: var(--accent-light);
        }

        /* Classes personnalisées propres (évite les erreurs de style en ligne) */
        .hero-banner {
            background: var(--grad);
            color: white;
            box-shadow: var(--shadow-lg);
        }

        /* Cartes d'événements */
        .card-event {
            background: var(--card);
            border: 1px solid var(--line);
            border-radius: var(--radius-lg);
            padding: 1.5rem;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            box-shadow: var(--shadow-sm);
        }

        .card-event:hover {
            transform: translateY(-6px);
            box-shadow: var(--shadow-lg);
            border-color: rgba(99, 102, 241, 0.3);
        }

        .date-badge {
            background: var(--accent-light);
            color: var(--accent);
            border-radius: 14px;
            padding: 0.6rem 0.85rem;
            text-align: center;
            font-weight: 700;
            line-height: 1.1;
            display: inline-block;
        }

        .date-badge .day {
            font-size: 1.4rem;
            font-family: 'Bricolage Grotesque', sans-serif;
            display: block;
        }

        .date-badge .month {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        /* Boutons */
        .btn-eh {
            background: var(--accent);
            color: #fff;
            font-weight: 600;
            border-radius: 99px;
            padding: 0.7rem 1.5rem;
            border: none;
            transition: all 0.2s ease;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-eh:hover {
            background: var(--accent-hover);
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 10px 20px -8px rgba(99, 102, 241, 0.6);
        }

        .btn-eh-outline {
            background: transparent;
            color: var(--ink);
            border: 1px solid var(--line);
            font-weight: 600;
            border-radius: 99px;
            padding: 0.65rem 1.3rem;
            transition: all 0.2s ease;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            justify-content: center;
        }

        .btn-eh-outline:hover {
            border-color: var(--accent);
            color: var(--accent);
            background: var(--accent-light);
        }

        .flash-container {
            position: fixed;
            top: 90px;
            right: 24px;
            z-index: 1050;
            max-width: 400px;
        }
    </style>

    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>

<!-- Messages Flash -->
<div class="flash-container">
    {% for type, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }} alert-dismissible fade show shadow-lg rounded-4 border-0 mb-2" role="alert">
                <i class="fa-solid fa-circle-check me-2"></i> {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}
    {% endfor %}
</div>

<!-- Header / Navigation -->
<header class="eh-nav">
    <div class="container d-flex align-items-center justify-content-between">
        <a class="brand" href="/">
            <span class="brand-mark"><i class="fa-solid fa-bolt"></i></span>
            EventHub <span style="color: var(--accent);">Enigma</span>
        </a>
        <nav class="d-none d-md-flex gap-2">
            <a class="nav-link-eh" href="/eventAll"><i class="fa-regular fa-calendar-days"></i> Événements</a>
            {% if is_granted('ROLE_ADMIN') or is_granted('ROLE_ORGANIZER') %}
                <a class="nav-link-eh" href="{{ path('yourevent') }}"><i class="fa-solid fa-layer-group"></i> Mes Événements</a>
            {% endif %}
            <a class="nav-link-eh" href="/inscriptions"><i class="fa-solid fa-ticket"></i> Mes Inscriptions</a>
        </nav>
        <div class="d-flex align-items-center gap-2">
            {% if app.user %}
                <span class="badge rounded-pill text-bg-light border me-2 py-2 px-3 fw-medium">
                    <i class="fa-solid fa-user me-1 text-primary"></i> {{ app.user.username ?? app.user.userIdentifier }}
                </span>
                <a class="btn-eh-outline py-2 px-3" href="{{ path('logout') }}"><i class="fa-solid fa-arrow-right-from-bracket"></i></a>
            {% else %}
                <a class="btn-eh-outline py-2 px-3" href="{{ path('app_login') }}">Connexion</a>
                <a class="btn-eh py-2 px-3" href="{{ path('app_register') }}">S'inscrire</a>
            {% endif %}
        </div>
    </div>
</header>

<main class="container py-5">
    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
