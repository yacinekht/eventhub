{% extends 'base.html.twig' %}

{% block title %}Mes Inscriptions | EventHub Enigma{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="fw-bold m-0"><i class="fa-solid fa-ticket text-primary me-2"></i>Mes Inscriptions</h1>
            <p class="text-muted small mt-1">Retrouvez l'historique et le statut de vos participations aux événements.</p>
        </div>
        <a href="/eventAll" class="btn-eh-outline">
            <i class="fa-solid fa-compass me-1"></i> Découvrir d'autres événements
        </a>
    </div>

    {% if registrations is empty %}
        <div class="text-center py-5 bg-white rounded-4 border shadow-sm">
            <i class="fa-solid fa-ticket-simple display-4 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold">Aucune inscription active</h4>
            <p class="text-muted mb-4">Tu n'es inscrit à aucun événement pour le moment.</p>
            <a href="/eventAll" class="btn-eh">Parcourir les événements</a>
        </div>
    {% else %}
        <div class="bg-white rounded-4 border shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light border-bottom">
                    <tr>
                        <th class="ps-4">Événement</th>
                        <th>Catégorie</th>
                        <th>Date & Heure</th>
                        <th>Statut</th>
                        <th>Inscrit le</th>
                        <th class="text-end pe-4">Action</th>
                    </tr>
                    </thead>
                    <tbody>
                    {% for registration in registrations %}
                        <tr>
                            <td class="ps-4">
                                <span class="fw-bold text-dark">{{ registration.event.title }}</span>
                            </td>
                            <td>
                            <span class="badge text-bg-light border">
                                {{ registration.event.category.name ?? 'Général' }}
                            </span>
                            </td>
                            <td>
                                <i class="fa-regular fa-calendar me-1 text-muted"></i>
                                {{ registration.event.startAt|date('d/m/Y H:i') }}
                            </td>
                            <td>
                                {% if registration.status.name == 'Confirmed' %}
                                    <span class="badge text-bg-success-subtle text-success border border-success-subtle rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-circle-check me-1"></i> Confirmée
                                </span>
                                {% elseif registration.status.name == 'Waitlist' %}
                                    <span class="badge text-bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-clock me-1"></i> Liste d'attente
                                </span>
                                {% else %}
                                    <span class="badge text-bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-3 py-2">
                                    <i class="fa-solid fa-circle-xmark me-1"></i> Annulée
                                </span>
                                {% endif %}
                            </td>
                            <td class="text-muted small">
                                {{ registration.createdAt|date('d/m/Y') }}
                            </td>
                            <td class="text-end pe-4">
                                <form action="{{ path('uninscriptionEvent', { slug: registration.event.slug }) }}" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-3" onclick="return confirm('Es-tu sûr de vouloir te désinscrire de cet événement ?')">
                                        <i class="fa-solid fa-user-minus me-1"></i> Se désinscrire
                                    </button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endblock %}
