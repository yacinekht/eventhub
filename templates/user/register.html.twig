{% extends 'base.html.twig' %}

{% block title %} {{ parent() }}Inscription{% endblock %}

{% block body %}
    <div class="auth-container">
        <h2>Rejoignez-nous</h2>

        {{ form_start(form, {'attr': {'class': 'form-signup'}}) }}

        {# Affichage des erreurs globales #}
        {{ form_errors(form) }}

        <div class="form-group p-1">
            {{ form_label(form.username) }}
            {{ form_widget(form.username, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.username) }}
        </div>

        {# Champ Email #}
        <div class="form-group p-1">
            {{ form_label(form.email, 'Adresse e-mail') }}
            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'exemple@mail.com'}}) }}
            {{ form_errors(form.email) }}
        </div>

        {# Champ Mot de passe #}
        <div class="form-group p-1">
            {{ form_label(form.password, 'Mot de passe') }}
            {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
            {{ form_errors(form.password) }}
        </div>


        <button type="submit" class="btn btn-primary">Créer mon compte</button>

        {{ form_end(form) }}
    </div>
{% endblock %}
