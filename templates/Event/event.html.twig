{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} | Tous les événements{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="fw-bold m-0"><i class="fa-solid fa-compass text-primary me-2"></i>Tous les événements</h1>
            <p class="text-muted small mt-1">Découvrez et rejoignez les prochains événements disponibles.</p>
        </div>
        <a href="/" class="btn-eh-outline">
            <i class="fa-solid fa-house me-1"></i> Accueil
        </a>
    </div>

    <div class="row g-4">
        {% for event in events %}
            <div class="col-md-6 col-lg-4">
                <div class="card-event">
                    <div>
                        <div class="d-flex align-items-start justify-content-between mb-3">
                            <div class="date-badge">
                                <span class="day">{{ event.startAt|date('d') }}</span>
                                <span class="month">{{ event.startAt|date('M') }}</span>
                            </div>
                            <span class="badge rounded-pill text-bg-light border px-3 py-2 fw-normal text-muted">
                            <i class="fa-regular fa-clock me-1"></i> {{ event.startAt|date('H:i') }}
                        </span>
                        </div>

                        <h3 class="h5 fw-bold text-dark mb-2">{{ event.title }}</h3>
                        <p class="text-muted small mb-3 text-truncate">Organisé par {{ event.organizer.username ?? 'Anonyme' }}</p>
                    </div>

                    <div class="pt-3 border-top mt-3">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <a href="{{ path('detailsEvent', {'slug': event.slug}) }}" class="btn-eh-outline w-50">Détails</a>

                            <form action="{{ path('inscriptionsEvent', {'slug': event.slug}) }}" method="post" class="w-50 m-0">
                                <button type="submit" class="btn-eh w-100">S'inscrire</button>
                            </form>
                        </div>

                        {% if is_granted('ROLE_ADMIN') or app.user == event.organizer %}
                            <div class="text-center mt-2">
                                <a href="{{ path('editevent', {'slug': event.slug}) }}" class="small text-muted text-decoration-none">
                                    <i class="fa-solid fa-pen-to-square me-1"></i> Modifier
                                </a>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col-12 text-center py-5 bg-white rounded-4 border shadow-sm">
                <i class="fa-regular fa-calendar-xmark display-4 text-muted mb-3 d-block"></i>
                <h4 class="fw-bold">Aucun événement</h4>
                <p class="text-muted mb-0">Aucun événement n'est publié pour le moment.</p>
            </div>
        {% endfor %}
    </div>
{% endblock %}
