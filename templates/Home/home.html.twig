{% extends 'base.html.twig' %}

{% block title %} {{ parent() }} | Homepage {% endblock %}

{% block body %}
    <div class="p-5 mb-4 bg-white rounded-3 shadow-sm"><h1>Organisez. Participez. Partagez.</h1>
        <p class="lead">Une plateforme de gestion d'événements avec inscription et liste d'attente.</p><a
            class="btn btn-primary" href='/eventAll'>Voir les événements</a>
    </div>
    <div class="p-5 mb-4 bg-white rounded-3 shadow-sm">
        <h2>Prochains événements</h2>
    </div>
    <div class="row">
        {% for event in events %}
            <div class="col-md-4 mb-3">
                <div class="card h-100">
                    <div class="card-body"><h3 class="h5">{{ event.title }}</h3>
                        <p>{{ event.startAt|date('d/m/Y H:i') }}</p>
                        <a href={{ path('detailsEvent', {'slug': event.slug}) }}>Détails →</a>
                        <form action="{{ path('inscriptionsEvent', {'slug': event.slug}) }}"
                              method="post">
                            <button type="submit">S'inscrire</button>
                        </form>


                        {% if is_granted('ROLE_ADMIN') or app.user == event.organizer  %}
                        <a href={{ path('editevent', {'slug': event.slug}) }}>Modifier l'évenement →</a>
                        {% endif %}



                    </div>
                </div>
            </div>
        {% else %}
            <p>Aucun événement publié.</p>
        {% endfor %}
    </div>

{% endblock %}


